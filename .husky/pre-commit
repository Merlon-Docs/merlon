# Fast and offline. The pre-push hook runs the full gate.
pnpm exec lint-staged
node scripts/pre-commit-affected.mjs

if command -v betterleaks >/dev/null 2>&1; then
  betterleaks git --pre-commit --staged --config .betterleaks.toml --redact --no-banner --verbose
else
  echo "warning: betterleaks not installed, so staged secrets are not scanned" >&2
fi
