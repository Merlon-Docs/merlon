---
// Whole guides versus single shards, in estimated tokens, read at build time from the CSV of
// the context-size research record. `pnpm bench:context-size` writes a new dated CSV; when a run
// gets its own record, point this import, RECORD_PATH and RECORD_TITLE at that record.
import csv from '../../../../docs/features/system/research/context-size-dogfood-2026-10-05.csv?raw';
import { BASE } from '../../site.config.mjs';

// The record's page on this site. The caption links it, as Benefit claims and evidence asks of
// public copy that uses a record's figure.
const RECORD_PATH = 'concepts/system/research/context-size-dogfood-2026-10-05/';
const RECORD_TITLE = "Context sizes: this repository's guides against one shard";

const metrics = new Map(
  csv
    .trim()
    .split('\n')
    .slice(1)
    .map((line) => {
      const [metric, value, , , recordedAt] = line.split(',');
      return [metric, { value, recordedAt }];
    }),
);
const num = (metric: string) => Number(metrics.get(metric)?.value ?? 0);
const shardCount = num('shard_count');
const fmt = new Intl.NumberFormat('en-US');

const rows = [
  {
    label: 'Features guide and glossary',
    note: 'the monolith, docs/_build/guides.md',
    tokens: num('guide_monolith_tokens'),
  },
  { label: 'Developer guide', note: 'DEVELOPERS.md', tokens: num('guide_developer_tokens') },
  { label: 'CLI guide', note: 'packages/merlon-docs-cli/README.md', tokens: num('guide_client_cli_tokens') },
  { label: 'Largest shard', note: 'one file', tokens: num('shard_max_tokens'), shard: true },
  { label: '90th percentile shard', note: 'one file', tokens: num('shard_p90_tokens'), shard: true },
  {
    label: 'Average shard',
    note: `mean of ${fmt.format(shardCount)} shards`,
    tokens: num('shard_mean_tokens'),
    shard: true,
  },
  { label: 'Median shard', note: 'one file', tokens: num('shard_median_tokens'), shard: true },
].filter((row) => row.tokens > 0);

const max = Math.max(...rows.map((row) => row.tokens));
const tokenizer = metrics.get('tokenizer')?.value ?? 'unknown';
const recordedAt = metrics.get('tokenizer')?.recordedAt;
---

<figure class="merlon-sizes">
  <table>
    <caption>
      Estimated tokens an agent loads: a whole compiled guide against one shard, measured on
      this repository's {fmt.format(shardCount)} shards.
    </caption>
    <thead>
      <tr>
        <th scope="col">What the agent reads</th>
        <th scope="col"><span class="sr-only">Relative size</span></th>
        <th scope="col">Tokens (estimate)</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class:list={[{ 'is-shard': row.shard }]}>
            <th scope="row">
              {row.label}
              <span>{row.note}</span>
            </th>
            <td class="merlon-sizes__bar" aria-hidden="true">
              <span style={`--w: ${Math.max(0.6, (row.tokens / max) * 100).toFixed(2)}%`} />
            </td>
            <td class="merlon-sizes__value">{fmt.format(row.tokens)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <figcaption>
    Counted with <code>{tokenizer}</code> from the open-source gpt-tokenizer{
      recordedAt && <> on {recordedAt}</>
    }. Every model and system tokenizes differently, so read these as rough, relative sizes,
    not costs. The dated record <a href={`${BASE}/${RECORD_PATH}`}>{RECORD_TITLE}</a> gives the
    method and the caveats. <a href={`${BASE}/contributing/benchmarks/`}>Benchmarks</a> says how to
    re-measure with <code>pnpm bench:context-size</code> and another tokenizer or a counter of your own.
  </figcaption>
</figure>
