{
  "name": "@bwilliamson/mdcp-core",
  "version": "0.8.0",
  "description": "MDCP core — documentation system compile, refs, and validation library",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/compile/hooks/builtin.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/mdcp.git",
    "directory": "packages/mdcp-core"
  },
  "bugs": {
    "url": "https://github.com/betsalel-williamson/mdcp/issues"
  },
  "homepage": "https://github.com/betsalel-williamson/mdcp/tree/main/packages/mdcp-core#readme",
  "keywords": [
    "markdown",
    "documentation",
    "compile",
    "refs",
    "validation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "github-slugger": "^2.0.0",
    "ignore": "^7.0.8",
    "semver": "^7.8.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
