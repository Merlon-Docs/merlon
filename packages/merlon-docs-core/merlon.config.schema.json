{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "GENERATED FILE, do not edit. Change packages/merlon-docs-core/src/config/schema.ts and run pnpm build, which runs packages/merlon-docs-core/scripts/generate-config-schema.mjs.",
  "type": "object",
  "properties": {
    "standardVersion": {
      "default": "1.0.0-draft.0",
      "description": "Four-part version of the Merlon Docs standard the repository conforms to.",
      "type": "string"
    },
    "protocolVersion": {
      "description": "Former name of standardVersion, still read until 2.0.0. Use standardVersion.",
      "deprecated": true,
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "outputDir": {
      "default": "_build",
      "description": "Generated output root relative to docs root.",
      "type": "string"
    },
    "outputFile": {
      "description": "Optional stitched monolith filename relative to outputDir.",
      "type": "string"
    },
    "compileOrder": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "banner": {
      "default": "<!-- AUTO-GENERATED by Merlon Docs — edit shards, then run: merlon compile -->\n\n",
      "type": "string"
    },
    "sourceTags": {
      "default": true,
      "description": "Wrap each shard's content in HTML source tags indicating its relative path.",
      "type": "boolean"
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "splitLevel": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "h1Extract"
                  },
                  "index": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "preamble": {
                    "type": "object",
                    "properties": {
                      "promoteToH2": {
                        "default": "About this guide",
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "index"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "merge"
                  },
                  "parts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fromH1Extract": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "demoteFirstH1": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "fromH1Extract"
                      ]
                    }
                  },
                  "preamble": {
                    "type": "object",
                    "properties": {
                      "promoteToH2": {
                        "default": "About this guide",
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "parts"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "directory"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path"
                ]
              }
            ]
          },
          "compile": {
            "type": "object",
            "properties": {
              "preambleSection": {
                "default": "about-this-guide.md",
                "type": "string"
              },
              "manifest": {
                "default": "index.md",
                "type": "string"
              },
              "sectionsHeading": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "scopeRoot": {
                "type": "string"
              },
              "outputFile": {
                "type": "string"
              },
              "includeBanner": {
                "default": true,
                "type": "boolean"
              },
              "sourceTags": {
                "type": "boolean"
              },
              "hooks": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                ]
              },
              "crossGuideLinks": {
                "type": "object",
                "properties": {
                  "ignoreGuides": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "hooksConfig": {
                "type": "object",
                "properties": {
                  "inlineInserts": {
                    "type": "object",
                    "properties": {
                      "searchRoots": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "stripAnchors": {
                "default": true,
                "type": "boolean"
              },
              "links": {
                "type": "object",
                "properties": {
                  "markBroken": {
                    "default": true,
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "standaloneGuides": {
      "default": [],
      "description": "Files or globs (relative to scan root) registered as standalone guides: captured by the coverage scan, with no compile output of their own.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scan": {
      "default": {
        "gitignore": true,
        "ignore": [],
        "strict": false
      },
      "description": "Repository-wide markdown coverage scan options.",
      "type": "object",
      "properties": {
        "gitignore": {
          "default": true,
          "description": "Honor the repository .gitignore when walking for markdown files.",
          "type": "boolean"
        },
        "ignore": {
          "default": [],
          "description": "Extra ignore globs beyond the built-in defaults (.git, node_modules, .agents).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "description": "Walk root for the scan (default: invocation directory).",
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Fail merlon check when uncaptured files or missing standalone entries exist.",
          "type": "boolean"
        }
      }
    },
    "backup": {
      "default": {
        "enabled": false,
        "dir": ".caches/backups",
        "ext": ""
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "dir": {
          "default": ".caches/backups",
          "type": "string"
        },
        "ext": {
          "default": "",
          "type": "string"
        }
      }
    },
    "refs": {
      "default": {
        "registryFile": ".caches/refs.json",
        "slugAlgorithm": "github"
      },
      "type": "object",
      "properties": {
        "registryFile": {
          "default": ".caches/refs.json",
          "type": "string"
        },
        "slugAlgorithm": {
          "default": "github",
          "type": "string",
          "enum": [
            "github"
          ]
        }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "markdownlint": {
          "type": "object",
          "properties": {
            "shardsConfig": {
              "type": "string"
            },
            "compiledConfig": {
              "type": "string"
            },
            "shardsGlobs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "severity": {
              "default": "error",
              "type": "string",
              "enum": [
                "error",
                "warn"
              ]
            },
            "target": {
              "type": "string"
            },
            "config": {
              "type": "string"
            }
          }
        },
        "codeExtensions": {
          "default": [],
          "description": "Extra code extensions, added to the built-in defaults. Validated for existence and citable by line.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataExtensions": {
          "default": [],
          "description": "Extra data extensions, added to the built-in defaults. Validated for existence, never cited by line.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "description": "Backtick-path resolution in documentation prose.",
          "type": "object",
          "properties": {
            "severity": {
              "default": "off",
              "type": "string",
              "enum": [
                "off",
                "warn",
                "error"
              ]
            },
            "searchRoots": {
              "default": [],
              "description": "Extra resolution roots relative to the scan root.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generated": {
              "default": [],
              "description": "Prefixes that are real but absent in a clean checkout: build output, caches, vendor-managed installs.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vocabulary": {
              "default": [],
              "description": "Exact names this repository documents without having, such as a tier the standard defines and a consumer creates.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "vale": {
      "type": "object",
      "properties": {
        "config": {
          "default": ".vale.ini",
          "type": "string"
        },
        "strictMinAlertLevel": {
          "default": "error",
          "type": "string"
        },
        "scanGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "default": {
        "maxIndexEntries": 12,
        "maxShardWords": 2500,
        "minDuplicateWords": 25
      },
      "description": "Thresholds for merlon review sprawl signals.",
      "type": "object",
      "properties": {
        "maxIndexEntries": {
          "default": 12,
          "description": "Most shard links one index group (links under one ## or deeper heading, or before any) may list before index-size fires.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxShardWords": {
          "default": 2500,
          "description": "Most prose words a shard may hold before long-shard fires.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minDuplicateWords": {
          "default": 25,
          "description": "Fewest words a paragraph needs before duplicate-paragraph compares it across shards.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "diagnostics": {
      "description": "Optional split diagnostic file sinks for merlon check, merlon compile, and merlon review.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory for split errors.txt and warnings.txt files (relative to outputDir or absolute).",
          "type": "string"
        },
        "errorsFile": {
          "description": "File path for error-severity diagnostics (relative to invocation directory or absolute).",
          "type": "string"
        },
        "warningsFile": {
          "description": "File path for warning-severity diagnostics (relative to invocation directory or absolute).",
          "type": "string"
        },
        "splitFiles": {
          "default": false,
          "description": "Write errors.txt and warnings.txt under diagnostics.dir (default .caches/diagnostics under outputDir).",
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "compileOrder"
  ],
  "title": "Merlon Docs configuration",
  "description": "Configuration schema for merlon.config.json, the Merlon Docs config file"
}
