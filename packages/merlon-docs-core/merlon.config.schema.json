{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "GENERATED FILE, do not edit. Change packages/merlon-docs-core/src/config/schema.ts and run pnpm build, which runs packages/merlon-docs-core/scripts/generate-config-schema.mjs.",
  "type": "object",
  "properties": {
    "configVersion": {
      "type": "string",
      "description": "Version of @merlon-docs/merlon-docs-core whose config format this file follows."
    },
    "standardVersion": {
      "description": "Former name of configVersion, still read until 2.0.0. Use configVersion.",
      "deprecated": true,
      "type": "string"
    },
    "protocolVersion": {
      "description": "Former name of configVersion, still read until 2.0.0. Use configVersion.",
      "deprecated": true,
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "outputDir": {
      "default": "_build",
      "description": "Generated output root relative to docs root.",
      "type": "string"
    },
    "outputFile": {
      "description": "Optional stitched monolith filename relative to outputDir.",
      "type": "string"
    },
    "compileOrder": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "banner": {
      "default": "<!-- AUTO-GENERATED by Merlon Docs — edit shards, then run: merlon compile -->\n\n",
      "type": "string"
    },
    "sourceTags": {
      "default": true,
      "description": "Wrap each shard's content in HTML source tags indicating its relative path.",
      "type": "boolean"
    },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "description": "Shard directory relative to docs root (default: {docsRoot}/{name}/).",
            "type": "string"
          },
          "splitLevel": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "h1Extract"
                  },
                  "index": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "preamble": {
                    "type": "object",
                    "properties": {
                      "promoteToH2": {
                        "default": "About this guide",
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "index"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "merge"
                  },
                  "parts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fromH1Extract": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "demoteFirstH1": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "fromH1Extract"
                      ]
                    }
                  },
                  "preamble": {
                    "type": "object",
                    "properties": {
                      "promoteToH2": {
                        "default": "About this guide",
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "parts"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "directory"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path"
                ]
              }
            ]
          },
          "compile": {
            "type": "object",
            "properties": {
              "preambleSection": {
                "default": "about-this-guide.md",
                "type": "string"
              },
              "manifest": {
                "default": "index.md",
                "description": "Manifest file name; review trees use shards.md.",
                "type": "string"
              },
              "sectionsHeading": {
                "description": "When set, only links after this ## heading in the manifest set compile order.",
                "type": "string"
              },
              "title": {
                "description": "Compile title, injected as a ## heading before the first section.",
                "type": "string"
              },
              "scopeRoot": {
                "type": "string"
              },
              "outputFile": {
                "description": "Output path for this guide, relative to outputDir or absolute.",
                "type": "string"
              },
              "includeBanner": {
                "default": true,
                "description": "Put the top-level banner at the head of this guide's output.",
                "type": "boolean"
              },
              "sourceTags": {
                "description": "Wrap each shard in source tags for this guide (default: top-level sourceTags).",
                "type": "boolean"
              },
              "hooks": {
                "description": "Named compile hooks. An array replaces the defaults; an object turns named hooks on or off.",
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                ]
              },
              "crossGuideLinks": {
                "description": "How links to other guides are rewritten when this guide is assembled.",
                "type": "object",
                "properties": {
                  "ignoreGuides": {
                    "description": "Guides whose shards this guide's links keep as .md paths instead of #slug targets. A link to a shard this guide stitches still gets its in-document anchor.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "hooksConfig": {
                "type": "object",
                "properties": {
                  "inlineInserts": {
                    "type": "object",
                    "properties": {
                      "searchRoots": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "stripAnchors": {
                "default": true,
                "type": "boolean"
              },
              "links": {
                "type": "object",
                "properties": {
                  "markBroken": {
                    "default": true,
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "standaloneGuides": {
      "default": [],
      "description": "Files or globs (relative to scan root) registered as standalone guides: captured by the coverage scan, with no compile output of their own.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scan": {
      "default": {
        "gitignore": true,
        "ignore": [],
        "strict": false
      },
      "description": "Repository-wide markdown coverage scan options.",
      "type": "object",
      "properties": {
        "gitignore": {
          "default": true,
          "description": "Honor .gitignore when walking for markdown files: the repository root's inside git, the scan root's outside it.",
          "type": "boolean"
        },
        "ignore": {
          "default": [],
          "description": "Extra ignore globs beyond the built-in defaults (.git, node_modules, .agents).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "description": "Walk root for the scan (default: invocation directory).",
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Fail merlon check when uncaptured files or missing standalone entries exist.",
          "type": "boolean"
        }
      }
    },
    "backup": {
      "default": {
        "enabled": false,
        "dir": ".caches/backups",
        "ext": ""
      },
      "description": "Back up existing compile targets before overwriting them.",
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "dir": {
          "default": ".caches/backups",
          "description": "Backup directory relative to outputDir.",
          "type": "string"
        },
        "ext": {
          "default": "",
          "description": "Suffix appended to each backup file name.",
          "type": "string"
        }
      }
    },
    "refs": {
      "default": {
        "registryFile": ".caches/refs.json",
        "slugAlgorithm": "github"
      },
      "type": "object",
      "properties": {
        "registryFile": {
          "default": ".caches/refs.json",
          "description": "Slug registry path relative to outputDir.",
          "type": "string"
        },
        "slugAlgorithm": {
          "default": "github",
          "type": "string",
          "enum": [
            "github"
          ]
        }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "markdownlint": {
          "type": "object",
          "properties": {
            "shardsConfig": {
              "type": "string"
            },
            "compiledConfig": {
              "type": "string"
            },
            "shardsGlobs": {
              "description": "Shard lint paths relative to docs root (default: the compileOrder guide directories).",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "severity": {
              "default": "error",
              "type": "string",
              "enum": [
                "error",
                "warn"
              ]
            },
            "target": {
              "type": "string"
            },
            "config": {
              "type": "string"
            }
          }
        },
        "codeExtensions": {
          "default": [],
          "description": "Extra code extensions, added to the built-in defaults. A link or path to such a file must resolve, and a symbol in the link label can cite a line in it, as for a stack the defaults leave out or for workflow YAML.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataExtensions": {
          "default": [],
          "description": "Extra data extensions, added to the built-in defaults. A link or path to such a file must resolve; its lines are never cited.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "description": "Backtick-path resolution in documentation prose.",
          "type": "object",
          "properties": {
            "severity": {
              "default": "off",
              "type": "string",
              "enum": [
                "off",
                "warn",
                "error"
              ]
            },
            "searchRoots": {
              "default": [],
              "description": "Extra resolution roots relative to the scan root, tried after it.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generated": {
              "default": [],
              "description": "Scan-root-relative prefixes that are real but absent in a clean checkout: build output, caches, vendor-managed installs. Everything beneath a prefix is covered.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vocabulary": {
              "default": [],
              "description": "Paths this repository documents without having: names the standard defines for a consumer repository, or another project's tree. Matched exactly, so a file beneath one still has to resolve.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "vale": {
      "type": "object",
      "properties": {
        "config": {
          "default": ".vale.ini",
          "type": "string"
        },
        "strictMinAlertLevel": {
          "default": "error",
          "type": "string"
        },
        "scanGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "default": {
        "maxIndexEntries": 12,
        "maxShardWords": 2500,
        "minDuplicateWords": 25
      },
      "description": "Thresholds for merlon review sprawl signals.",
      "type": "object",
      "properties": {
        "maxIndexEntries": {
          "default": 12,
          "description": "Most shard links one index group (links under one ## or deeper heading, or before any) may list before index-size fires.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxShardWords": {
          "default": 2500,
          "description": "Most prose words a shard may hold before long-shard fires.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minDuplicateWords": {
          "default": 25,
          "description": "Fewest words a paragraph needs before duplicate-paragraph compares it across shards.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "diagnostics": {
      "description": "Optional split diagnostic file sinks for merlon check, merlon compile, and merlon review.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory for split errors.txt and warnings.txt files (relative to outputDir or absolute).",
          "type": "string"
        },
        "errorsFile": {
          "description": "File path for error-severity diagnostics (relative to invocation directory or absolute).",
          "type": "string"
        },
        "warningsFile": {
          "description": "File path for warning-severity diagnostics (relative to invocation directory or absolute).",
          "type": "string"
        },
        "splitFiles": {
          "default": false,
          "description": "Write errors.txt and warnings.txt under diagnostics.dir (default .caches/diagnostics under outputDir).",
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "configVersion",
    "compileOrder"
  ],
  "title": "Merlon Docs configuration",
  "description": "Configuration schema for merlon.config.json, the Merlon Docs config file"
}
