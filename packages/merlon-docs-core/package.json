{
  "name": "@merlon-docs/merlon-docs-core",
  "version": "1.0.0-draft.0",
  "description": "Merlon Docs core: compile, refs and validation library for a sharded documentation tree",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/compile/hooks/builtin.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merlon-Docs/merlon.git",
    "directory": "packages/merlon-docs-core"
  },
  "bugs": {
    "url": "https://github.com/Merlon-Docs/merlon/issues"
  },
  "homepage": "https://github.com/Merlon-Docs/merlon/tree/main/packages/merlon-docs-core#readme",
  "keywords": [
    "markdown",
    "documentation",
    "compile",
    "refs",
    "validation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "github-slugger": "^2.0.0",
    "ignore": "^7.0.12",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
