{
  "name": "@bwilliamson/mdcp-cli",
  "version": "0.7.6",
  "description": "MDCP CLI — documentation system compile and check (MarkDown Context Protocol)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "mdcp": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betsalel-williamson/mdcp.git",
    "directory": "packages/mdcp-cli"
  },
  "bugs": {
    "url": "https://github.com/betsalel-williamson/mdcp/issues"
  },
  "homepage": "https://github.com/betsalel-williamson/mdcp/tree/main/packages/mdcp-cli#readme",
  "keywords": [
    "markdown",
    "documentation",
    "cli",
    "mdcp"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=20000",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@bwilliamson/mdcp-core": "workspace:*",
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
