{
  "$schema": "../packages/mdcp-core/mdcp.config.schema.json",
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": [
    "features",
    "developer",
    "client-cli",
    "client-core",
    "repo-readme",
    "presentation-la-devops"
  ],
  "banner": "<!-- AUTO-GENERATED by mdcp \u2014 edit shards, then run: mdcp compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../DEVELOPERS.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-cli",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-cli/README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-core",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/mdcp-core/README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "repo-readme",
      "compile": {
        "outputFile": "../../README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features", "client-cli", "developer"]
        }
      }
    },
    {
      "name": "presentation-la-devops",
      "compile": {
        "outputFile": "../../presentations/la-devops-2026.md",
        "includeBanner": false,
        "sourceTags": false,
        "crossGuideLinks": {
          "ignoreGuides": ["features", "client-cli", "developer", "repo-readme", "client-core"]
        }
      }
    }
  ],
  "standaloneGuides": [
    "AGENTS.md",
    "CLAUDE.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/skills.md",
    "docs/vale-local/README.md",
    "packages/mdcp-presets/README.md",
    "skills/**/*.md"
  ],
  "scan": {
    "strict": true,
    "ignore": [
      ".changeset/**",
      ".github/**",
      ".cursor/**",
      ".claude/**",
      ".husky/**",
      ".vscode/**",
      ".superpowers/**",
      "docs/superpowers/**",
      ".worktrees/**",
      ".specstory/**",
      ".tmp/**",
      ".caches/**",
      ".pnpm-store/**",
      ".compile-build/**",
      ".shard-work/**",
      "legacy/**",
      "docs/superpowers/**",
      "tests/**",
      "examples/**",
      "**/CHANGELOG.md"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../packages/mdcp-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "compiled-lint.markdownlint-cli2.jsonc",
      "shardsGlobs": [
        "glossary",
        "features",
        "developer",
        "client-cli",
        "client-core",
        "repo-readme",
        "presentation-la-devops"
      ]
    },
    "paths": {
      "severity": "error",
      "searchRoots": [
        "packages/mdcp-core",
        "packages/mdcp-core/src",
        "packages/mdcp-cli",
        "packages/mdcp-cli/src",
        "packages/mdcp-presets",
        "tests/skills/mdcp"
      ],
      "generated": [
        "docs/_build",
        "_build",
        ".caches",
        ".agents",
        ".tmp",
        "build",
        "node_modules",
        ".claude/skills",
        ".windsurf/skills"
      ],
      "vocabulary": ["docs/client", "docs/extensions"]
    }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": [
      "glossary",
      "features",
      "developer",
      "client-cli",
      "client-core",
      "repo-readme",
      "presentation-la-devops"
    ]
  }
}
