{
  "$schema": "../packages/merlon-docs-core/merlon.config.schema.json",
  "configVersion": "1.0.0",
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "developer", "client-cli", "client-core", "repo-readme"],
  "banner": "<!-- AUTO-GENERATED by Merlon Docs \u2014 edit shards, then run: merlon compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../DEVELOPERS.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-cli",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/merlon-docs-cli/README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "client-core",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "../../packages/merlon-docs-core/README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features"]
        }
      }
    },
    {
      "name": "repo-readme",
      "compile": {
        "outputFile": "../../README.md",
        "crossGuideLinks": {
          "ignoreGuides": ["features", "client-cli", "developer"]
        }
      }
    }
  ],
  "standaloneGuides": [
    "AGENTS.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/skills.md",
    "docs/vale-local/README.md",
    "packages/merlon-docs-presets/README.md",
    "skills/**/*.md"
  ],
  "scan": {
    "strict": true,
    "ignore": [
      ".changeset/**",
      ".github/**",
      ".cursor/**",
      ".claude/**",
      ".husky/**",
      ".vscode/**",
      ".superpowers/**",
      "docs/superpowers/**",
      ".worktrees/**",
      ".specstory/**",
      ".tmp/**",
      ".caches/**",
      ".pnpm-store/**",
      ".compile-build/**",
      ".shard-work/**",
      "legacy/**",
      "docs/superpowers/**",
      "tests/**",
      "examples/**",
      "**/.terraform/**",
      "**/CHANGELOG.md"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../packages/merlon-docs-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "compiled-lint.markdownlint-cli2.jsonc",
      "shardsGlobs": [
        "glossary",
        "features",
        "developer",
        "client-cli",
        "client-core",
        "repo-readme"
      ]
    },
    "paths": {
      "severity": "error",
      "searchRoots": [
        "packages/merlon-docs-core",
        "packages/merlon-docs-core/src",
        "packages/merlon-docs-cli",
        "packages/merlon-docs-cli/src",
        "packages/merlon-docs-presets",
        "tests/skills/merlon-docs"
      ],
      "generated": [
        "docs/_build",
        "_build",
        ".caches",
        ".agents",
        ".tmp",
        "build",
        "node_modules",
        ".claude/skills",
        ".windsurf/skills",
        ".changeset/pre",
        "packages/merlon-docs-site/.generated"
      ],
      "vocabulary": ["docs/client", "docs/extensions", ".changeset/pre.json"]
    }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": ["glossary", "features", "developer", "client-cli", "client-core", "repo-readme"]
  }
}
