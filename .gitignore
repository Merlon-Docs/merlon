# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/

# Merlon Docs temp / cache
.compile-build/
.shard-work/
.caches/
*.llm.md

# Tooling auto-save / local state
.specstory/

# Test / typecheck artifacts
coverage/
*.tsbuildinfo

# Local IDE / indexing
.cursor/*
!.cursor/environment.json
.cursorindexingignore
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
.superpowers/
# Superpowers agent specs/plans (ephemeral; durable docs live in Merlon Docs shards)
docs/superpowers/

# Linked git worktrees (local agent / contributor checkouts)
.worktrees/

# Agent Skills — local installs / workspaces (publishable source lives in skills/)
.agents/skills/merlon-docs/
.agents/skills/merlon-docs-arch-oss-library/
.agents/skills/merlon-docs-arch-product-docs-site/
.agents/skills/merlon-docs-arch-gtm/
.agents/skills/merlon-docs-arch-research/
.agents/skills/*-workspace/
skills/*-workspace/
# skill-creator is vendored (committed) for the local live-eval loop — do not gitignore
# but ignore its python cache artifacts
.agents/skills/skill-creator/**/__pycache__/
.agents/skills/skill-creator/**/*.pyc

# VS Code (keep shared workspace config)
.vscode/*

.tmp/

# Legacy generated reports
legacy/.cache/
legacy/anchors.json
legacy/vale-report.json

examples/sample-guides/styles/*
!examples/sample-guides/styles/.gitkeep

docs/styles/*
!docs/styles/.gitkeep

# Merlon Docs compiled output (repo docs — regenerate with pnpm docs:compile:repo)
docs/_build/

# Slidev renders of the frozen talk deck, presentations/la-devops-2026.md
build/presentations/

# Sample guides fixture output
examples/sample-guides/_build/

# Docs site (packages/merlon-docs-site): Astro cache plus pages and sidebar generated
# from docs/ shards by scripts/sync-content.mjs. Only the landing page is authored.
packages/merlon-docs-site/.astro/
packages/merlon-docs-site/.generated/
packages/merlon-docs-site/src/content/docs/*
!packages/merlon-docs-site/src/content/docs/index.mdx
!packages/merlon-docs-site/src/content/docs/learn.mdx

# OS
.DS_Store

.tmp-release-notes.md
